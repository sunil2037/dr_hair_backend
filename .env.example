# Server Configuration
PORT=5001
NODE_ENV=development
BASE_URL=http://localhost:5001

# Security & Authentication
# Required: generate with `openssl rand -base64 32` and paste into your local .env.
JWT_SECRET=
JWT_EXPIRES_IN=30d
CORS_ORIGINS=

# The first Super Admin can authenticate from this private local bootstrap account.
# Generate the scrypt hash with `npm run admin:setup`; never store a plain password here.
SUPER_ADMIN_ID=
SUPER_ADMIN_NAME=Dr. Hair Super Admin
SUPER_ADMIN_PASSWORD_HASH=

# Production must use an external OTP delivery API; development uses the test OTP above.

# MongoDB Atlas; obtain the application URI from Atlas and keep it private.
MONGODB_URI=

# File Upload Configuration (uploads are sent directly to Cloudinary)
MAX_FILE_SIZE_MB=10
MAX_MEDIA_FILE_SIZE_MB=100

# Cloudinary (testing video storage and delivery)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_VIDEO_FOLDER=drhair/testing
CLOUDINARY_IMAGE_FOLDER=drhair/images

# Firebase Admin SDK (backend push notifications)
# Add credentials only after creating the Firebase project and service identity.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Use matching Razorpay Test Mode or Live API credentials. Never put the secret in the mobile app.
# Keep the Key Secret and webhook secret only in the backend environment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# OAuth web client ID from Firebase Project settings. Used to verify Google ID tokens.
GOOGLE_OAUTH_CLIENT_ID=

# Shiprocket (use the separate API user created under Shiprocket Settings > API)
# Keep these server-side. A matching pickup location and packed parcel measurements are required.
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PACKAGE_LENGTH_CM=
SHIPROCKET_PACKAGE_BREADTH_CM=
SHIPROCKET_PACKAGE_HEIGHT_CM=
SHIPROCKET_PACKAGE_WEIGHT_KG=

# OTP Settings
OTP_EXPIRY_MINUTES=10

# SMS / OTP Gateway Configuration (2Factor.in is primary)
SMS_PROVIDER=2factor
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE_NAME=

# Legacy Fast2SMS Gateway Configuration (Optional fallback)
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp

# Google Gemini Flash AI (Medical Assistant, Scalp Analysis & Hair Test)
# Get your free key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
